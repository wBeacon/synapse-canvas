{
  "name": "dsh-synapse",
  "version": "0.5.0",
  "description": "A visual, non-linear conversation workspace plugin for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core/conversation": "./core/conversation.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "app.js",
    "deepseek-mark.svg",
    "styles.css",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "core",
    "adapters",
    "preview"
  ],
  "scripts": {
    "build": "node --check index.js && node --check client.js && node --check app.js && node --check core/conversation.js && node --check adapters/dsh.js && node --check adapters/workbuddy.js && node --check preview/server.js && node --check preview/app.js",
    "preview:workbuddy": "node preview/server.js",
    "prepare": "pnpm run build",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "immediately": false
    }
  }
}
